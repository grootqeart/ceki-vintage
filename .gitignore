**/node_modules

# Secrets / local config
local.env
production.env
.env
.env.local
**/.env.local
**/.env.*.local

# Build output. Both are generated by `npm run build` (see scripts/build.js):
# the client builds into client/build, which is then copied over
# server/public. Committing them would mean every build shows up as a huge
# diff of minified bundles, and a stale copy could get deployed instead of a
# fresh one.
client/build
server/public

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

loca/~$Loca_Keys_Strings_DE_EN.xlsx
~$WIFI-Projekt Präsentation.pptx

# Claude Code per-machine settings (personal, not shared)
.claude/settings.local.json

# Ephemeral quick-tunnel hostname, rewritten on every restart
.tunnel-url

# Backups of edited assets
*.bak
