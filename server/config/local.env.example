# Salin file ini jadi `local.env` di folder yang sama, lalu isi nilainya.
#
#   cp server/config/local.env.example server/config/local.env
#
# `local.env` tidak ikut ke git (lihat .gitignore) karena isinya rahasia.
# File ini hanya dibaca saat NODE_ENV bukan production -- di Render, nilainya
# datang dari environment variable, bukan dari file ini.

# WAJIB. Penanda tangan token login. Tanpa ini, daftar dan login langsung
# gagal dengan "secretOrPrivateKey must have a value".
# Isi string acak panjang apa saja, mis. hasil dari:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Connection string MongoDB Atlas, mis.
#   mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/ceki?retryWrites=true&w=majority
#
# Boleh dikosongkan: kalau kosong, server memakai database sementara di memori
# yang isinya HILANG setiap kali server dimatikan. Cukup untuk coba-coba,
# tidak cukup kalau mau akunnya bertahan.
MONGO_URI=

PORT=5000
NODE_ENV=development

# Paksa pakai database sementara walaupun MONGO_URI terisi. Berguna untuk
# menguji tanpa menyentuh data sungguhan.
USE_MEMORY_DB=false

# OAuth client id untuk login Google. Boleh dikosongkan -- kode sudah punya
# nilai bawaan (nilainya publik, bukan rahasia). Isi hanya kalau kamu memakai
# proyek Google Cloud sendiri.
GOOGLE_CLIENT_ID=

# Hanya untuk email "lupa password". Boleh dikosongkan seluruhnya.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PW=
