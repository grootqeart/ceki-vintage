# Salin jadi `.env.local` di folder yang sama kalau perlu:
#
#   cp client/.env.local.example client/.env.local
#
# SELURUH file ini opsional -- aplikasi jalan tanpanya. Nilainya dibaca saat
# BUILD, bukan saat jalan, dan ditanam permanen ke dalam bundle JavaScript.
#
# Karena itu jangan pernah menaruh rahasia di sini. Apa pun yang masuk file ini
# bisa dibaca siapa saja lewat kode halaman.

# OAuth client id Google. Kode sudah punya nilai bawaan, jadi isi hanya kalau
# kamu memakai proyek Google Cloud sendiri. Harus sama dengan GOOGLE_CLIENT_ID
# di sisi server.
REACT_APP_GOOGLE_CLIENT_ID=

# Contentful. Boleh dikosongkan: teks aplikasi sudah ada salinannya di
# client/src/context/content/localizedContent.json dan itu yang dipakai kalau
# kredensialnya tidak ada.
REACT_APP_CONTENTFUL_SPACE_ID=
REACT_APP_CONTENTFUL_ACCESS_TOKEN=

# Kosongkan. Server menyajikan aplikasinya sendiri, jadi socket menyambung ke
# origin yang sama. Isi hanya kalau server berada di alamat yang berbeda.
REACT_APP_SERVER_URI=

REACT_APP_GOOGLE_ANALYTICS_TRACKING_ID=
